SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENWA_BASE_URL=http://openwa-api:2785
OPENWA_LOCAL_API_KEY=
OPENWA_SESSION_ID=
BINNO_WORKER_SECRET=
OPENWA_WEBHOOK_SECRET=

# De quanto em quanto tempo o relay varre a fila, em milissegundos.
# Padrao 10000. Era 60000 ate 29/08/2026, e um minuto de silencio fazia o
# botao de teste do painel parecer quebrado para quem apertava.
# BINNO_DISPATCH_INTERVAL_MS=10000

# Estas duas NAO sao do relay: pertencem ao .env de /opt/binno/openwa na VPS.
# Ficam registradas aqui porque sem elas o envio para de funcionar sozinho apos um reinicio.
# WWEBJS_ONBOARDING_CONTINUE_LABELS=Usar nesta janela,Usar aqui,Continuar,Use Here,Continue
# AUTO_START_SESSIONS=true
