
# Google Places API key
# Replace with your actual key when deploying
# You can get a key at https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google Business Profile OAuth. These are server-only secrets. The redirect
# URI must exactly match the callback configured in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-project.supabase.co/functions/v1/google-business-oauth-callback
APP_URL=https://your-app-domain.example

# Temporary Apify pilot. Keep disabled until an explicit spend cap is approved.
# This token is server-only and must never be exposed through Vite variables.
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_EXPERIMENTAL_ENABLED=false
APIFY_EXPERIMENTAL_MONTHLY_RUN_LIMIT=10
